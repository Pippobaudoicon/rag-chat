# =============================================================================
# rag-chat — Environment Variables Template
# Copy this to .env.local and fill in the values.
# Most secrets are injected automatically via Vercel Marketplace integrations.
# Run: vercel env pull .env.local --yes
# =============================================================================

# Clerk Auth (provisioned via: vercel integration add clerk)
# Vercel previews need a real publishable key. Local .clerk keyless files are ignored.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Optional server-side fallback for environments where only CLERK_PUBLISHABLE_KEY is set.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Clerk Billing
# Create a user-scoped Pro plan in Clerk Billing and copy its plan ID/key here.
CLERK_BILLING_PRO_PLAN_ID=
NEXT_PUBLIC_CLERK_BILLING_PRO_PLAN_ID=
CLERK_BILLING_PRO_PLAN_KEY=pro_user
NEXT_PUBLIC_CLERK_BILLING_PRO_PLAN_KEY=pro_user
# Optional comma-separated plan slugs accepted as Pro. Defaults include "pro".
CLERK_BILLING_PRO_PLAN_SLUG=pro_user
NEXT_PUBLIC_CLERK_BILLING_PRO_PLAN_SLUG=pro_user

# Neon Postgres (provisioned via: vercel integration add neon)
DATABASE_URL=

# Upstash Redis (provisioned via: vercel integration add upstash).
# Also enables resumable chat-stream replay after navigation. Without it, the
# server continues the active generation while alive and clients poll DB status.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Voyage AI — same API key as the hymns/ Python app
VOYAGE_API_KEY=

# Pinecone — same API key as hymns/ (read-only operations here)
PINECONE_API_KEY=
# Target Pinecone index. Defaults to "lds-rag-v1" (English-main corpus with
# study_helps + graph related_ids). Set to "lds-rag" only for the legacy index.
PINECONE_INDEX=lds-rag-v1
# Corpus language for retrieval. Defaults to eng (lds-rag-v1). Set to ita only for the legacy index.
RAG_INDEX_LANGUAGE=eng

# Graph-aware reranking (boost chunks central in the cross-reference neighborhood).
# Default ON; set to false only to disable (kill-switch). A/B it with `npm run eval`.
RAG_GRAPH_RERANK=true

# Eager/speculative retrieval: run the default semantic_search during the preamble
# so the model answers on turn 1 (kills the empty tool-decision round-trip).
# Conservative topical allowlist — skips chit-chat / follow-ups / scripture refs /
# specific-talk requests / fixed chunks / empty sources. Default OFF; opt in with
# true only after latency-trace + output/citation parity validation.
RAG_EAGER_RETRIEVAL=false

# --- Optional retrieval ranking stack (semantic path only; all default OFF) ---
# Cross-encoder rerank of the candidate pool via Voyage rerank-2.5. Adds an API
# call (cost + latency); validate with `npm run eval` before enabling.
RAG_RERANK=false
# Multi-query expansion: LLM generates a few query phrasings to broaden recall.
RAG_MULTI_QUERY=false
# Per-source / per-title diversity caps on the returned top-k.
RAG_MMR=false

# Optional override. Defaults to deepseek/deepseek-v4-flash in src/app/api/chat/route.ts.
CHAT_MODEL=deepseek/deepseek-v4-flash

# Legacy retrieval-query routing/translation model. Disabled by default because
# CHAT_MODEL now emits corpus-language tool arguments in its existing step.
# Set RAG_LANGUAGE_ROUTING=true only to restore this dedicated model + fallback.
RAG_LANGUAGE_ROUTING=false
RAG_ROUTING_MODEL=openai/gpt-oss-120b
RAG_ROUTING_FALLBACK_MODEL=openai/gpt-5.4-mini

# Optional nested LLM audit inside citation_verifier. Structural citation-index
# validation always runs; leave this off to avoid another model call per answer.
RAG_CLAIM_SUPPORT_AUDIT=false
CITATION_AUDIT_MODEL=openai/gpt-5.4-mini

# Optional chat personalization memory controls.
CHAT_MEMORY_ENABLED=true
CHAT_MEMORY_BRIEF_CHARS=700
CHAT_MEMORY_CONTEXT_CHARS=3500

# Optional per-user chat rate limit backed by Upstash Redis.
CHAT_RATE_LIMIT_MAX_REQUESTS=30
CHAT_RATE_LIMIT_WINDOW=1h

# Optional subscription limits. Free chat falls back to CHAT_RATE_LIMIT_MAX_REQUESTS.
SUBSCRIPTION_RATE_LIMIT_WINDOW=1h
SUBSCRIPTION_PRO_CHAT_RATE_LIMIT=300
SUBSCRIPTION_FREE_SEARCH_RATE_LIMIT=60
SUBSCRIPTION_PRO_SEARCH_RATE_LIMIT=600
SUBSCRIPTION_FREE_MAX_TOP_K=10
SUBSCRIPTION_PRO_MAX_TOP_K=20

# Vercel AI Gateway (DO NOT set manually — auto-provisioned via vercel env pull)
# VERCEL_OIDC_TOKEN=
